REM ==========================================
REM PIXEL-BASIC: SYSTEMS SIMULATION STRESS TEST
REM ==========================================

SCREEN 800, 600
CLEAR_SCREEN

REM 1. Dictionaries & Arrays (Engine State)
LET engine_state = [
  running = TRUE,
  tick = 0,
  max_ticks = 200,
  render_mode = 2
]

REM A flat array representing a 2D matrix grid
LET flat_matrix = [10, 20, 30, 40]

REM 2. Subroutines & Logic (Euclidean Distance approximation)
SUB get_distance x1, y1, x2, y2 THEN
  LET dx = x2 - x1
  LET dy = y2 - y1
  RETURN (dx * dx) + (dy * dy)
END SUB

REM 3. Array Mutation & Loops (Matrix processing)
SUB process_matrix grid, size THEN
  LET i = 0
  WHILE i < size THEN
    grid[i] *= 2
    i += 1
  END WHILE
  RETURN grid
END SUB

PRINT "Initializing stylized simulation..."
PRINT "Processed Matrix Output:"
PRINT process_matrix(flat_matrix, 4)

LET particle_x = 0
LET particle_y = 300

REM 4. Main Graphics Loop (Switch, Math, Break, Continue)
WHILE engine_state["running"] == TRUE THEN
  
  SWITCH engine_state["render_mode"] THEN
    CASE 1 THEN FILL_COLOR 255, 0, 0 END CASE
    CASE 2 THEN FILL_COLOR 0, 255, 255 END CASE
    DEFAULT THEN FILL_COLOR 255, 255, 255 END DEFAULT
  END SWITCH

  IF particle_x % 50 == 0 THEN
    REM Test CONTINUE by skipping rendering on specific grid lines
    particle_x += 1
    CONTINUE
  END IF

  REM Calculate dynamic Y using the SIN function 
  particle_y = 300 + SIN(particle_x * 0.1 + engine_state["tick"] * 0.05) * 50

  DRAW_RECT particle_x, particle_y, 4, 4
  particle_x += 2

  engine_state["tick"] += 1
  
  IF engine_state["tick"] >= engine_state["max_ticks"] THEN
    PRINT "Simulation Complete. Terminating loop."
    engine_state["running"] = FALSE
    BREAK
  END IF

END WHILE
